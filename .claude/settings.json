{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/enforce-ownership.mjs"],
            "timeout": 15,
            "statusMessage": "Checking file ownership"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/validate-on-data-edit.mjs"],
            "timeout": 60,
            "statusMessage": "Validating content data"
          }
        ]
      }
    ]
  }
}
